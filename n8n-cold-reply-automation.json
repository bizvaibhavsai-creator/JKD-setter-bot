    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4o-mini",
        "additionalFields": {
          "messages": [
            {
              "role": "system",
              "content": "=You are an expert cold-email setter assistant.\n\nYour job:\n1. Analyze the prospect reply.\n2. Classify it into exactly one of these labels: interested, not_interested, objection, out_of_office, referral, booked, wrong_person, follow_up_needed.\n3. Use the Google Doc playbook as the source of truth for tone and reply logic.\n4. Draft a human-sounding email reply.\n5. Return strict JSON only.\n\nRules:\n- Be concise and natural.\n- Never sound robotic.\n- If the prospect is clearly not interested, politely close the conversation.\n- If they ask a question or object, answer using the playbook if possible.\n- If the playbook is missing specifics, write the safest professional response.\n- Keep line breaks in the reply_body.\n- Do not include markdown fences.\n\nReturn JSON with exactly these keys:\n{\n  \"classification\": \"interested | not_interested | objection | out_of_office | referral | booked | wrong_person | follow_up_needed\",\n  \"sheet_status\": \"short status for google sheet\",\n  \"confidence\": 0.0,\n  \"reason\": \"one short sentence\",\n  \"reply_subject\": \"email subject\",\n  \"reply_body\": \"email body\"\n}"
            },
            {
              "role": "user",
              "content": "={{ `Prospect name: ${$json.prospect_name || 'Unknown'}\nProspect email: ${$json.prospect_email}\nThread ID: ${$json.thread_id}\nOriginal subject: ${$json.original_subject || 'N/A'}\nCampaign name: ${$json.campaign_name || 'N/A'}\nCompany name: ${$json.company_name || 'N/A'}\nSender name: ${$json.sender_name || 'Sales Team'}\n\nProspect reply:\n${$json.reply_text}\n\nGoogle Doc playbook:\n${$json.playbook_text || 'No playbook text found.'}` }}"
            }
          ],
          "temperature": 0.2
        }
      },
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        -120,
        80
      ],
      "id": "4e6914f1-9e8a-4db9-a3a2-openai0000001",
      "name": "Analyze And Draft"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nfunction getContent(data) {\n  if (typeof data?.choices?.[0]?.message?.content === 'string') return data.choices[0].message.content;\n  if (typeof data?.choices?.[0]?.text === 'string') return data.choices[0].text;\n  if (typeof data?.text === 'string') return data.text;\n  return JSON.stringify(data);\n}\n\nconst content = getContent(raw).trim();\nlet parsed;\n\ntry {\n  parsed = JSON.parse(content);\n} catch {\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n  if (!match) {\n    throw new Error('OpenAI response was not valid JSON: ' + content);\n  }\n  parsed = JSON.parse(match[0]);\n}\n\nreturn [\n  {\n    json: {\n      classification: parsed.classification || 'follow_up_needed',\n      sheet_status: parsed.sheet_status || parsed.classification || 'follow_up_needed',\n      confidence: parsed.confidence ?? 0,\n      reason: parsed.reason || '',\n      reply_subject: parsed.reply_subject || 'Re: Your reply',\n      reply_body: parsed.reply_body || 'Thanks for your reply.',\n    },\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
