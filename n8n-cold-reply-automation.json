    {
      "parameters": {
        "jsCode": "const source = $input.first().json;\n\nfunction collectText(value, out = []) {\n  if (value === null || value === undefined) return out;\n\n  if (typeof value === 'string') {\n    const trimmed = value.trim();\n    if (trimmed) out.push(trimmed);\n    return out;\n  }\n\n  if (Array.isArray(value)) {\n    for (const item of value) collectText(item, out);\n    return out;\n  }\n\n  if (typeof value === 'object') {\n    if (typeof value.text === 'string') out.push(value.text);\n    if (typeof value.content === 'string') out.push(value.content);\n    if (typeof value.plainText === 'string') out.push(value.plainText);\n    if (typeof value.title === 'string') out.push(value.title);\n    if (value.textRun && typeof value.textRun.content === 'string') out.push(value.textRun.content);\n\n    for (const key of Object.keys(value)) {\n      if (['text', 'content', 'plainText', 'title', 'textRun'].includes(key)) continue;\n      collectText(value[key], out);\n    }\n  }\n\n  return out;\n}\n\nconst chunks = collectText(source, []);\nconst seen = new Set();\nconst unique = chunks\n  .map((chunk) => chunk.replace(/\\s+/g, ' ').trim())\n  .filter((chunk) => chunk && !seen.has(chunk) && seen.add(chunk));\n\nreturn [\n  {\n    json: {\n      playbook_text: unique.join('\\n').slice(0, 12000),\n    },\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -580,
